# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# OpenRouter (AI)
OPENROUTER_API_KEY=your_openrouter_api_key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Twitter API
TWITTER_BEARER_TOKEN=your_twitter_bearer_token
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_WEBHOOK_SECRET=your_webhook_secret

# LinkedIn API
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
LINKEDIN_PERSON_ID=your_linkedin_person_id
LINKEDIN_WEBHOOK_SECRET=your_webhook_secret

# Reddit API
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_ACCESS_TOKEN=your_reddit_access_token
REDDIT_WEBHOOK_SECRET=your_webhook_secret

# Redis / Upstash (optional for caching)
REDIS_URL=your_redis_url

# Vercel / Deployment
NEXT_PUBLIC_VERCEL_URL=your_vercel_url

# Optional: Sentry for error tracking
SENTRY_DSN=your_sentry_dsn
